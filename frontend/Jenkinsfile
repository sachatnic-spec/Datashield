node {
  stage('Checkout') {
    checkout scm
  }
  
  stage('Build') {
    bat 'go mod download || exit /b 0'
    bat 'go build -o app.exe .'
  }
  
  stage('Package & Move') {
    script {
      if (!fileExists('app.exe')) {
        error 'Build output app.exe not found'
      }
      def ts = bat(script: '@echo %date:~-10,2%%date:~-7,2%%date:~-4,4%%time:~0,2%%time:~3,2%%time:~6,2%', returnStdout: true).trim()
      def dest = "new_build_${ts}"
      bat "if not exist ${dest} mkdir ${dest}"
      bat "move app.exe ${dest}\\"
      env.BIN_PATH = "${dest}\\app.exe"
      echo "Moved app.exe -> ${env.BIN_PATH}"
    }
  }
  
  stage('Run') {
    bat '''
      start /B "${BIN_PATH}" > app.log 2>&1
      echo Started app
    '''
  }
}