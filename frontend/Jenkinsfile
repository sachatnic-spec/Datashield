node {
  stage('Checkout') {
    checkout scm
  }
  
  stage('Build') {
    sh 'go mod download || true'
    sh 'go build -o app .'
  }
  
  stage('Package & Move') {
    script {
      if (!fileExists('app')) {
        error 'Build output app not found'
      }
      def ts = sh(script: 'date +%Y%m%d%H%M%S', returnStdout: true).trim()
      def dest = "new_build_${ts}"
      sh "mkdir -p ${dest}"
      sh "mv app ${dest}/"
      env.BIN_PATH = "${dest}/app"
      echo "Moved app -> ${env.BIN_PATH}"
    }
  }
  
  stage('Run') {
    sh '''
      nohup "${BIN_PATH}" > app.log 2>&1 &
      echo $! > app.pid
      echo "Started app PID $(cat app.pid)"
    '''
  }
}
