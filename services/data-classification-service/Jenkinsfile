node('master') {
  stage('Checkout') {
    checkout scm
  }
  
  stage('Build') {
    sh 'mvn clean install -DskipTests'
  }
  
  stage('Package & Move') {
    script {
      def jar = sh(script: 'ls target/*.jar 2>/dev/null | head -n1', returnStdout: true).trim()
      if (!jar) {
        error 'No JAR found in target/ — build failed'
      }
      def ts = sh(script: 'date +%Y%m%d%H%M%S', returnStdout: true).trim()
      def dest = "new_build_${ts}"
      sh "mkdir -p ${dest}"
      sh "mv ${jar} ${dest}/"
      env.JAR_PATH = "${dest}/${jar.tokenize('/')[-1]}"
      echo "Moved ${jar} -> ${env.JAR_PATH}"
    }
  }
  
  stage('Run') {
    sh '''
      nohup java -jar "${JAR_PATH}" > app.log 2>&1 &
      echo $! > app.pid
      echo "Started jar as PID $(cat app.pid)"
    '''
  }
}
