FROM jenkins/jenkins:lts

USER root

# Install Java, Maven, Go, Python, Node, Git
RUN apt-get update && apt-get install -y \
    openjdk-21-jdk-headless \
    maven \
    golang-go \
    python3 \
    python3-pip \
    nodejs \
    npm \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Verify installations
RUN java -version && \
    mvn -version && \
    go version && \
    python3 --version && \
    node --version && \
    npm --version

USER jenkins

# Install recommended Jenkins plugins
RUN jenkins-plugin-cli --latest-only --plugins \
    workflow-aggregator \
    git \
    github \
    docker-workflow \
    pipeline-model-definition
