// ============================================================
// Master Jenkinsfile - Build, Deploy & Run ALL Projects
// Handles: Maven Services, Python Services, React UIs
// Dynamic detection, no hardcoded paths
// ============================================================

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 4, unit: 'HOURS')
    }

    environment {
        BUILD_DIR        = "${WORKSPACE}/build-output"
        DEPLOY_DIR       = "${WORKSPACE}/deploy"
        LOGS_DIR         = "${WORKSPACE}/deploy/logs"
        SERVICES_DIR     = "${WORKSPACE}/services"
        FRONTEND_DIR     = "${WORKSPACE}/frontend"
        MAVEN_OPTS       = "-Xmx2g -Xms512m"
        NODE_ENV         = "production"
        TIMESTAMP        = sh(script: "date +%Y%m%d_%H%M%S", returnStdout: true).trim()
    }

    stages {
        stage('Checkout') {
            steps {
                echo "==> Checking out repository..."
                checkout scm
            }
        }

        stage('Prepare Directories') {
            steps {
                sh '''
                    mkdir -p "${BUILD_DIR}" "${DEPLOY_DIR}" "${LOGS_DIR}"
                    chmod -R 755 "${BUILD_DIR}" "${DEPLOY_DIR}" "${LOGS_DIR}"
                    echo "✓ Build directories ready"
                '''
            }
        }

        stage('Build Maven Services') {
            steps {
                script {
                    echo "==> Building Maven services in parallel..."
                    
                    def mavenServices = [
                        'ai-analysis-service', 'analytics-service', 'anomaly-detection-service',
                        'audit-service', 'auth-service', 'breach-service', 'config-service',
                        'connector-service', 'consent-service', 'data-classification-service',
                        'data-discovery-service', 'data-lineage-service', 'dpbi-service',
                        'grievance-service', 'notification-service', 'pii-detection-service',
                        'policy-service', 'report-service', 'retention-service', 'rights-service',
                        'risk-scoring-service', 'search-service', 'siem-service', 'tenant-service',
                        'vendor-service', 'webhook-service', 'workflow-service'
                    ]
                    
                    def buildJobs = [:]
                    
                    mavenServices.each { service ->
                        buildJobs[service] = {
                            try {
                                echo "🔨 ${service}..."
                                sh """
                                    cd "${SERVICES_DIR}/${service}"
                                    mvn clean package -DskipTests -q
                                    mkdir -p "${BUILD_DIR}/${service}"
                                    cp target/*.jar "${BUILD_DIR}/${service}/" || true
                                """
                            } catch (Exception e) {
                                echo "✗ ${service} failed"
                                throw e
                            }
                        }
                    }
                    
                    parallel buildJobs
                }
            }
        }

        stage('Build Python Services') {
            steps {
                script {
                    echo "==> Building Python services..."
                    
                    def pythonServices = [
                        'ai-analysis', 'anomaly-detection', 'pii-detection', 'risk-scoring'
                    ]
                    
                    def buildJobs = [:]
                    
                    pythonServices.each { service ->
                        buildJobs[service] = {
                            try {
                                echo "🐍 ${service}..."
                                sh """
                                    cd "${SERVICES_DIR}/${service}"
                                    python3 -m venv .venv || true
                                    . .venv/bin/activate 2>/dev/null || true
                                    pip install --upgrade pip -q 2>/dev/null
                                    [ -f requirements.txt ] && pip install -r requirements.txt -q || true
                                    [ -f setup.py ] && pip install -e . -q || true
                                    
                                    mkdir -p "${BUILD_DIR}/${service}"
                                    cp -r app models utils *.py requirements.txt "${BUILD_DIR}/${service}/" 2>/dev/null || true
                                """
                            } catch (Exception e) {
                                echo "⚠ ${service} build warning (non-critical)"
                            }
                        }
                    }
                    
                    parallel buildJobs
                }
            }
        }

        stage('Build UI Projects') {
            steps {
                script {
                    echo "==> Building UI projects..."
                    
                    def uiProjects = [
                        'compliance-dashboard', 'consent-widget', 'data-principal-portal'
                    ]
                    
                    def buildJobs = [:]
                    
                    uiProjects.each { project ->
                        buildJobs[project] = {
                            try {
                                echo "🎨 ${project}..."
                                sh """
                                    cd "${FRONTEND_DIR}/${project}"
                                    npm install --legacy-peer-deps -q 2>&1 | grep -v "WARN" || true
                                    npm run build --omit=dev 2>&1 | tail -5
                                    
                                    mkdir -p "${BUILD_DIR}/${project}"
                                    if [ -d "dist" ]; then
                                        cp -r dist/* "${BUILD_DIR}/${project}/"
                                    elif [ -d "build" ]; then
                                        cp -r build/* "${BUILD_DIR}/${project}/"
                                    fi
                                """
                            } catch (Exception e) {
                                echo "✗ ${project} failed"
                                throw e
                            }
                        }
                    }
                    
                    parallel buildJobs
                }
            }
        }

        stage('Deploy Artifacts') {
            steps {
                sh '''
                    echo "==> Copying artifacts to deploy folder..."
                    
                    # Copy all artifacts
                    cp -r "${BUILD_DIR}"/* "${DEPLOY_DIR}/" 2>/dev/null || true
                    
                    # Create deployment structure
                    mkdir -p "${DEPLOY_DIR}/services"
                    mkdir -p "${DEPLOY_DIR}/ui"
                    
                    # Organize by type
                    find "${DEPLOY_DIR}" -maxdepth 1 -name "*-service" -type d -exec mv {} "${DEPLOY_DIR}/services/" \\;
                    find "${DEPLOY_DIR}" -maxdepth 1 \\( -name "compliance-dashboard" -o -name "consent-widget" -o -name "data-principal-portal" \\) -type d -exec mv {} "${DEPLOY_DIR}/ui/" \\;
                    
                    echo "✓ Artifacts deployed"
                '''
            }
        }

        stage('Stop Previous Instances') {
            steps {
                sh '''
                    echo "==> Stopping previous instances..."
                    pkill -f "java.*${DEPLOY_DIR}" 2>/dev/null || true
                    pkill -f "python.*${DEPLOY_DIR}" 2>/dev/null || true
                    sleep 2
                    echo "✓ Previous instances stopped"
                '''
            }
        }

        stage('Start Java Services') {
            steps {
                script {
                    echo "==> Starting Java services..."
                    
                    def servicePorts = [
                        'auth-service': '8001', 'config-service': '8002', 'audit-service': '8003',
                        'notification-service': '8004', 'analytics-service': '8005', 'ai-analysis-service': '8006',
                        'anomaly-detection-service': '8007', 'breach-service': '8008', 'consent-service': '8009',
                        'connector-service': '8010', 'data-classification-service': '8011', 'data-discovery-service': '8012',
                        'data-lineage-service': '8013', 'dpbi-service': '8014', 'grievance-service': '8015',
                        'pii-detection-service': '8016', 'policy-service': '8017', 'report-service': '8018',
                        'retention-service': '8019', 'rights-service': '8020', 'risk-scoring-service': '8021',
                        'search-service': '8022', 'siem-service': '8023', 'tenant-service': '8024',
                        'vendor-service': '8025', 'webhook-service': '8026', 'workflow-service': '8027'
                    ]
                    
                    sh '''
                        startedServices=0
                        failedServices=0
                        
                        for service_dir in "${DEPLOY_DIR}"/services/*-service; do
                            service_name=$(basename "$service_dir")
                            jar_file=$(find "$service_dir" -name "*.jar" | head -1)
                            
                            if [ -f "$jar_file" ]; then
                                port=$(grep "'${service_name}'" <<< "''' + servicePorts.toString() + '''" | grep -oP ':\\K[0-9]+' | head -1)
                                if [ -z "$port" ]; then
                                    port=$((8000 + $(ls "${DEPLOY_DIR}"/services | wc -l)))
                                fi
                                
                                nohup java -Dserver.port=$port -jar "$jar_file" > "${LOGS_DIR}/${service_name}.log" 2>&1 &
                                sleep 1
                                echo "✓ Started ${service_name} on port ${port}"
                                ((startedServices++))
                            else
                                ((failedServices++))
                            fi
                        done
                        
                        echo ""
                        echo "Started: $startedServices | Failed: $failedServices"
                    '''
                }
            }
        }

        stage('Start UI Services') {
            steps {
                sh '''
                    echo "==> Starting UI services..."
                    
                    ui_port=3000
                    
                    for ui_dir in "${DEPLOY_DIR}"/ui/*; do
                        if [ -d "$ui_dir" ]; then
                            ui_name=$(basename "$ui_dir")
                            
                            # Start simple HTTP server for UI
                            cd "$ui_dir"
                            nohup python3 -m http.server $ui_port > "${LOGS_DIR}/${ui_name}.log" 2>&1 &
                            echo "✓ Started ${ui_name} on port ${ui_port}"
                            
                            ui_port=$((ui_port + 1))
                            sleep 1
                        fi
                    done
                '''
            }
        }

        stage('Start Python Services') {
            steps {
                sh '''
                    echo "==> Starting Python services..."
                    
                    python_port=5000
                    
                    for py_dir in "${DEPLOY_DIR}"/{ai-analysis,anomaly-detection,pii-detection,risk-scoring}; do
                        if [ -d "$py_dir" ]; then
                            py_name=$(basename "$py_dir")
                            
                            # Activate venv and start Flask/FastAPI app
                            cd "$py_dir"
                            if [ -f "app/main.py" ] || [ -f "main.py" ]; then
                                nohup python3 main.py --port=$python_port > "${LOGS_DIR}/${py_name}.log" 2>&1 &
                                echo "✓ Started ${py_name} on port ${python_port}"
                                python_port=$((python_port + 1))
                            fi
                            sleep 1
                        fi
                    done
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    echo "==> Running health checks..."
                    sleep 5
                    
                    for port in 8001 8002 8003 8004 8005 3000 5000; do
                        if timeout 2 bash -c "echo >/dev/tcp/localhost/$port" 2>/dev/null; then
                            echo "✓ Port $port: OK"
                        else
                            echo "⚠ Port $port: Not responding"
                        fi
                    done
                '''
            }
        }
    }

    post {
        always {
            sh '''
                echo "=========================================="
                echo "BUILD & DEPLOYMENT COMPLETE"
                echo "=========================================="
                echo "Timestamp: ${TIMESTAMP}"
                echo "Deploy Directory: ${DEPLOY_DIR}"
                echo "Logs Directory: ${LOGS_DIR}"
                echo ""
                echo "Running Services:"
                ps aux | grep -E "java|python.*main" | grep -v grep || echo "None found"
                echo ""
                echo "Log Files:"
                ls -lh "${LOGS_DIR}/" 2>/dev/null | tail -10
            '''
            archiveArtifacts artifacts: 'build-output/**,deploy/**', allowEmptyArchive: true
        }
        success {
            echo "✓ ALL PROJECTS BUILT AND SERVICES STARTED!"
        }
        failure {
            echo "✗ Build/deployment failed. Check logs."
        }
    }
}
