pipeline {
    agent { label 'windows-local' }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    triggers {
        // Every job with this trigger fires on each push to the repo;
        // the 'when { changeset }' guards below make Build/Deploy a
        // no-op (marked skipped) unless THIS service's files changed.
        githubPush()
    }

    environment {
        SERVICE_NAME = 'frontend'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            when {
                anyOf {
                    changeset pattern: "frontend/**", comparator: 'GLOB'
                    triggeredBy 'UserIdCause' // manual "Build Now" always runs
                }
            }
            steps {
                bat "scripts\\build-all.bat frontend"
            }
        }

        stage('Deploy') {
            // Frontend has no backend port to deploy - it's just a build.
            // Remove this stage or replace with your static-file copy /
            // ng-serve restart step if you deploy the frontend locally too.
            when {
                anyOf {
                    changeset pattern: "frontend/**", comparator: 'GLOB'
                    triggeredBy 'UserIdCause'
                }
            }
            steps {
                echo 'Frontend built - add your own deploy step here (e.g. copy dist/ to a static host, or restart ng serve).'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'logs/**', allowEmptyArchive: true
        }
        failure {
            echo 'frontend: build or deploy failed - check the archived logs.'
        }
        success {
            echo 'frontend: build + deploy completed successfully.'
        }
    }
}
