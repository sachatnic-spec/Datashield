pipeline {
    agent { label 'windows-local' }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    triggers {
        // Every job with this trigger fires on each push to the repo;
        // the 'when { changeset }' guards below make Build/Deploy a
        // no-op (marked skipped) unless THIS service's files changed.
        githubPush()
    }

    environment {
        SERVICE_NAME = 'workflow-service'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            when {
                anyOf {
                    changeset pattern: "services/workflow-service/**", comparator: 'GLOB'
                    triggeredBy 'UserIdCause' // manual "Build Now" always runs
                }
            }
            steps {
                bat "scripts\\build-all.bat workflow-service"
            }
        }

        stage('Deploy') {
            when {
                anyOf {
                    changeset pattern: "services/workflow-service/**", comparator: 'GLOB'
                    triggeredBy 'UserIdCause'
                }
            }
            steps {
                bat "scripts\\deploy-all.bat workflow-service"
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'logs/**', allowEmptyArchive: true
        }
        failure {
            echo 'workflow-service: build or deploy failed - check the archived logs.'
        }
        success {
            echo 'workflow-service: build + deploy completed successfully.'
        }
    }
}
